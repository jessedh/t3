# Indexer (Ponder) environment — copy to `.env.local`
# Points the indexer at your local chain and the deployed diamond.

# RPC endpoint of the local chain (Hardhat node or local Besu devnet).
PONDER_RPC_URL=http://127.0.0.1:8545

# Address of the deployed T3 diamond on that chain (from your local deploy output).
PONDER_DIAMOND_ADDRESS=0xYOUR_DIAMOND_ADDRESS

# Chain id of the local network (Besu devnet = 1337; Hardhat = 31337).
PONDER_CHAIN_ID=1337

# Optional: block to start indexing from (default 0 for a fresh local chain).
# PONDER_START_BLOCK=0
