# T3 settlement keeper — copy to .env. Ships DISABLED; both gates must be on to run.
# This is a counsel-pending preview component; do not point it at a production system.

# Double activation gate (see SETTLEMENT-KEEPER-RUNBOOK.md). Daemon refuses to start unless true
# AND the on-chain settlementModelActive flag is true.
KEEPER_ENABLED=false

# Chain
KEEPER_RPC_URL=http://127.0.0.1:8545
KEEPER_DIAMOND_ADDRESS=
# Keeper signing key — MUST hold SETTLEMENT_KEEPER_ROLE. Use a dedicated key, never an admin key.
KEEPER_PRIVATE_KEY=

# Indexer (Wave 6A) — obligation system of record for root + reconciliation
KEEPER_INDEXER_URL=http://127.0.0.1:42069

# Cadence (seconds)
KEEPER_CYCLE_WINDOW_SEC=300
KEEPER_CONFIRM_WINDOW_SEC=3600
KEEPER_CYCLE_TYPE=0

# Ops
KEEPER_HEALTH_PORT=8799
KEEPER_MAX_BACKOFF_SEC=60
