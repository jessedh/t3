# Required — for local development this targets the local chain (Hardhat node / Besu devnet).
RELAYER_PRIVATE_KEY=0xYOUR_RELAYER_PRIVATE_KEY
BESU_LOCAL_RPC_URL=http://127.0.0.1:8545
NETWORK_LABEL=localhost
FORWARDER_ADDRESS=0xYOUR_FORWARDER_ADDRESS
ALLOWED_TO=0xYOUR_DIAMOND_ADDRESS

# Function selectors allowed (comma-separated)
# Post-cutover: only resolvable selectors. Phantom selectors 0x68b9eb07, 0xeb51ea00, 0xdcabb0fa,
# 0xeb0f846e have been permanently removed — do NOT re-add them.
#
# Minimal config (ERC-20 direct transfer only):
#   ALLOWED_SELECTORS=0xa9059cbb,0x23b872dd
#
# Full envelope config (enable per product rail as needed):
#
#   0xa9059cbb  transfer(address,uint256)                                  T3TokenDirectTransferFacet
#   0x23b872dd  transferFrom(address,address,uint256)                      T3TokenDirectTransferFacet
#   0xb2f743d5  createEnvelope(address,uint256,uint40,uint8,uint8,bytes)   TransferEnvelopeFacet
#   0x4f05e8d9  createSmartLockEnvelope(address,uint256,bytes32,bytes32,uint40,address) SmartLockEnvelopeFacet
#   0x14d5ccb8  createCambioNoteWithPhrase(string,uint256,uint256)         CambioEnvelopeFacet
#   0x82cc9248  redeemByPhrase(bytes32,string,uint256,uint256,string)      CambioEnvelopeFacet
#   0x7060ddb7  commitRedemption(bytes32,uint256)                          CambioEnvelopeFacet
#   0x4c35090c  revealRedemption(bytes32,string,uint256,uint256)           CambioEnvelopeFacet
#
ALLOWED_SELECTORS=0xa9059cbb,0x23b872dd

# Guardrails
MAX_GAS=1500000
MAX_TTL_SECONDS=300
RATE_WINDOW_MS=60000
RATE_LIMIT=60

# Idempotency
IDEMPOTENCY_TTL_MS=300000

# Sponsor budgets (0 to disable)
SPONSOR_WINDOW_MS=60000
SPONSOR_MAX_TXS_PER_MIN=0
SPONSOR_MAX_GAS_PER_MIN=0

# Scoring / observation mode
OBSERVATION_MODE=true
ENFORCE_WARN_AT=400
ENFORCE_DENY_AT=800

# Optional external checks (timeouts contribute to score)
EXTERNAL_CHECK_A_URL=
EXTERNAL_CHECK_B_URL=
EXTERNAL_CHECK_A_WEIGHT=700
EXTERNAL_CHECK_B_WEIGHT=300
EXTERNAL_TIMEOUT_MS=1500

# Startup selector validation: if true (default), fatal-exit if any allowed selector is unregistered
# on the Diamond. Set to false ONLY for dev environments with incomplete diamond state — the relayer
# will then log a warning and continue.
RELAYER_STRICT_SELECTOR_CHECK=true

# Railway sets PORT automatically; the server uses PORT if defined
# PORT=8080
